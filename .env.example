# ===== App =====
NODE_ENV=development
APP_PORT=3000

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logmgmt
POSTGRES_USER=logmgmt_user
POSTGRES_PASSWORD=changeme

# ===== Auth / JWT =====
JWT_SECRET=changeme_use_a_long_random_string
JWT_EXPIRES_IN=8h

# ===== Ingest =====
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
INGEST_HTTP_PATH=/ingest

# ===== Alerting =====
ALERT_CHECK_INTERVAL_MS=60000
# ตัวเลือก: ตั้งค่าถ้าต้องการส่ง alert ออก webhook/email จริง
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ===== Retention =====
RETENTION_DAYS=7

# ===== TLS (SaaS mode) =====
TLS_CERT_PATH=./deploy/certs/cert.pem
TLS_KEY_PATH=./deploy/certs/key.pem
